# ============================================================
# PH5 backend environment  (copy to backend/.env for local dev)
# On Render, set these in the service's "Environment" tab instead.
# ============================================================

# ---- App ----
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API (your Vercel URL in prod), or *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Model artifacts (relative to backend/) ----
TEXT_MODEL_DIR=models/text/bert_finetuned
URL_MODEL_DIR=models/url/distilbert_url
IMAGE_MODEL_PATH=models/image/best_model.pth
# Optional: HF Hub repo containing text/, url/, image/ folders. Downloaded on startup if local files are missing.
HF_MODEL_REPO=
HF_TOKEN=
# Load all models in the background at startup (recommended in production)
PRELOAD_MODELS=false

# ---- Inference ----
MAX_UPLOAD_MB=10
FUSION_ALPHA=0.80

# ---- OCR (optional) ----
USE_OCR=true
# Full path to tesseract binary, or leave empty to use PATH
TESSERACT_CMD=
N8N_OCR_ENDPOINT=

# ---- LLM: Groq (https://console.groq.com/keys) ----
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Optional for reasoning models: none | low | default  (leave empty to use model default)
GROQ_REASONING_EFFORT=
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
# Use the LLM to route /chat intents (falls back to heuristics on failure)
USE_LLM_INTENT=false
